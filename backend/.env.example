# Copia este archivo como .env  →  cp .env.example .env   (el .env NO se sube a GitHub)
ENVIRONMENT=development

# ⚠️ PENDIENTE: pega aquí tu cadena de conexión.
# Supabase → proyecto Arkio → botón "Connect" (arriba) → pestaña "Connection String"
# → método "Session pooler" → copia la URI y reemplaza [YOUR-PASSWORD] por la contraseña
# de la base de datos (si no la recuerdas: Project Settings → Database → Reset database password).
# Se puede pegar tal cual empieza con postgresql://
DATABASE_URL=

SUPABASE_URL=https://iuimrfxuijrkxzbjrypd.supabase.co
# Solo si tu proyecto firma con "Legacy JWT secret" (HS256): Project Settings → JWT Keys.
# Si usa "JWT Signing Keys" (ES256/RS256) déjalo vacío: el backend usa las claves públicas.
SUPABASE_JWT_SECRET=

CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=America/Santiago
REALTIME_ENABLED=true

# Correo de invitaciones: log (solo muestra el enlace en consola) | smtp | resend
EMAIL_PROVIDER=log
EMAIL_FROM=Arkio <no-reply@arkio.app>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
RESEND_API_KEY=
INVITATION_TTL_HOURS=72
